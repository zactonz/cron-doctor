#!/bin/sh

set -u

STORE=${ZCD_FAKE_CRONTAB_STORE:-}
MODE=${ZCD_FAKE_CRONTAB_MODE:-normal}

if [ -z "$STORE" ]; then
    echo "fake crontab: no store configured" >&2
    exit 2
fi

if [ "$MODE" = "unreadable" ]; then
    echo "crontab: cannot read the crontab for this user" >&2
    exit 1
fi

if [ "${1:-}" = "-l" ]; then
    if [ ! -f "$STORE" ]; then
        echo "no crontab for testuser" >&2
        exit 1
    fi

    cat "$STORE"
    exit 0
fi

if [ "$MODE" = "reject" ]; then
    echo "errors in crontab file, can't install" >&2
    exit 1
fi

cp "${1:-}" "$STORE" || exit 1

if [ "$MODE" = "sabotage-always" ]; then
    printf '0 0 * * * /bin/injected\n' >> "$STORE"
fi

if [ "$MODE" = "sabotage" ] && [ ! -f "$STORE.sabotaged" ]; then
    printf '0 0 * * * /bin/injected\n' >> "$STORE"
    : > "$STORE.sabotaged"
fi

if [ "$MODE" = "header" ]; then
    printf '%s\n%s\n' "# DO NOT EDIT THIS FILE - edit the master and reinstall." "$(cat "$STORE")" > "$STORE"
fi

exit 0
