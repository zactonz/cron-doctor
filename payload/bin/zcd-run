#!/bin/sh

set -u

ZCD_RUNNER_VERSION="1.0.0"

EXIT_REFUSED=78
EXIT_TIMEOUT=124

fail_refused() {
    printf 'zcd: refusing to run job %s: %s\n' "${JOB_ID:-?}" "$1" >&2
    exit "$EXIT_REFUSED"
}

warn() {
    printf 'zcd: %s\n' "$1" >&2
}

find_binary() {
    _name=$1
    _resolved=$(command -v "$_name" 2>/dev/null) || _resolved=""

    if [ -n "$_resolved" ] && [ -x "$_resolved" ]; then
        printf '%s' "$_resolved"
        return 0
    fi

    for _dir in /usr/bin /bin /usr/local/bin /usr/sbin /sbin; do
        if [ -x "$_dir/$_name" ]; then
            printf '%s' "$_dir/$_name"
            return 0
        fi
    done

    return 1
}

file_mode() {
    stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null
}

file_owner() {
    stat -c '%u' "$1" 2>/dev/null || stat -f '%u' "$1" 2>/dev/null
}

file_size() {
    wc -c < "$1" 2>/dev/null | tr -d ' \n' || printf '0'
}

is_digits() {
    case "${1:-}" in
        '' | *[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

now_seconds() {
    date +%s
}

now_millis() {
    _nanos=$(date +%s%N 2>/dev/null) || _nanos=""

    if is_digits "$_nanos" && [ "${#_nanos}" -ge 16 ]; then
        printf '%s' $(( _nanos / 1000000 ))
        return 0
    fi

    printf '%s' $(( $(now_seconds) * 1000 ))
}

mode_allows_other_writers() {
    _mode=$1

    while [ "${#_mode}" -lt 4 ]; do
        _mode="0$_mode"
    done

    _group_digit=$(printf '%s' "$_mode" | cut -c3)
    _other_digit=$(printf '%s' "$_mode" | cut -c4)

    case "$_group_digit$_other_digit" in
        *[2367]*) return 0 ;;
    esac

    return 1
}

require_private_path() {
    _path=$1
    _label=$2

    _owner=$(file_owner "$_path") || _owner=""
    _mode=$(file_mode "$_path") || _mode=""

    if [ -z "$_owner" ] || [ -z "$_mode" ]; then
        fail_refused "$_label could not be inspected"
    fi

    if [ "$_owner" != "$CURRENT_UID" ]; then
        fail_refused "$_label is owned by uid $_owner, not $CURRENT_UID"
    fi

    if mode_allows_other_writers "$_mode"; then
        fail_refused "$_label is writable by other users (mode $_mode)"
    fi
}

require_private_directory() {
    [ -d "$1" ] || fail_refused "$2 is missing"

    require_private_path "$1" "$2"
}

require_private_file() {
    [ -f "$1" ] || fail_refused "$2 is missing"

    require_private_path "$1" "$2"
}

setting() {
    _key=$1
    _fallback=$2

    if [ ! -f "$CONF_FILE" ]; then
        printf '%s' "$_fallback"
        return 0
    fi

    _line=$(grep -E "^${_key}=" "$CONF_FILE" 2>/dev/null | tail -n 1) || _line=""

    if [ -z "$_line" ]; then
        printf '%s' "$_fallback"
        return 0
    fi

    printf '%s' "${_line#*=}"
}

numeric_setting() {
    _value=$(setting "$1" "$2")

    if is_digits "$_value"; then
        printf '%s' "$_value"
    else
        printf '%s' "$2"
    fi
}

release_lock() {
    if [ "$LOCK_STYLE" = "directory" ] && [ "$LOCK_HELD" = "1" ]; then
        rm -f "$LOCK_DIR/pid" 2>/dev/null || true
        rmdir "$LOCK_DIR" 2>/dev/null || true
        LOCK_HELD=0
    fi
}

acquire_flock() {
    if ! exec 9>"$LOCK_FILE" 2>/dev/null; then
        return 2
    fi

    if "$FLOCK_BIN" -n 9 2>/dev/null; then
        LOCK_HELD=1
        return 0
    fi

    return 1
}

lock_is_stale() {
    _holder=$(cat "$LOCK_DIR/pid" 2>/dev/null) || _holder=""

    if [ -z "$_holder" ] || ! is_digits "$_holder"; then
        return 0
    fi

    if kill -0 "$_holder" 2>/dev/null; then
        return 1
    fi

    return 0
}

acquire_directory_lock() {
    if mkdir "$LOCK_DIR" 2>/dev/null; then
        printf '%s\n' "$$" > "$LOCK_DIR/pid" 2>/dev/null || true
        LOCK_HELD=1
        return 0
    fi

    if ! lock_is_stale; then
        return 1
    fi

    _salvage="$LOCK_DIR.stale.$$"

    if mv "$LOCK_DIR" "$_salvage" 2>/dev/null; then
        rm -rf "$_salvage" 2>/dev/null || true
    fi

    if mkdir "$LOCK_DIR" 2>/dev/null; then
        printf '%s\n' "$$" > "$LOCK_DIR/pid" 2>/dev/null || true
        LOCK_HELD=1
        STALE_LOCK_BROKEN=1
        return 0
    fi

    return 1
}

acquire_lock() {
    if [ -n "$FLOCK_BIN" ]; then
        LOCK_STYLE="flock"
        acquire_flock
        return $?
    fi

    LOCK_STYLE="directory"
    acquire_directory_lock
    return $?
}

stop_child() {
    if [ "$GROUP_KILL" = "1" ] && kill -"$1" "-$CHILD_PID" 2>/dev/null; then
        return 0
    fi

    kill -"$1" "$CHILD_PID" 2>/dev/null || true
}

watchdog_loop() {
    _elapsed=0

    while [ "$_elapsed" -lt "$TIMEOUT_SECONDS" ]; do
        sleep 1
        _elapsed=$(( _elapsed + 1 ))

        if [ -f "$DONE_FLAG" ]; then
            return 0
        fi
    done

    : > "$TIMEOUT_FLAG" 2>/dev/null || true
    stop_child TERM

    _grace=0

    while [ "$_grace" -lt 5 ] && [ ! -f "$DONE_FLAG" ]; do
        sleep 1
        _grace=$(( _grace + 1 ))
    done

    stop_child KILL
}

run_with_watchdog() {
    TIMEOUT_FLAG="$RUN_DIR/.$SEQUENCE.timeout"
    DONE_FLAG="$RUN_DIR/.$SEQUENCE.done"
    rm -f "$TIMEOUT_FLAG" "$DONE_FLAG" 2>/dev/null || true

    if [ -n "$SETSID_BIN" ]; then
        "$SETSID_BIN" "$SHELL_BIN" "$CMD_FILE" < "$STDIN_SOURCE" > "$OUT_FILE" 2>&1 &
        CHILD_PID=$!
        GROUP_KILL=1
    else
        "$SHELL_BIN" "$CMD_FILE" < "$STDIN_SOURCE" > "$OUT_FILE" 2>&1 &
        CHILD_PID=$!
        GROUP_KILL=0
        ORPHANS_POSSIBLE=1
    fi

    watchdog_loop &
    WATCHDOG_PID=$!

    wait "$CHILD_PID" 2>/dev/null
    EXIT_CODE=$?

    : > "$DONE_FLAG" 2>/dev/null || true
    kill "$WATCHDOG_PID" 2>/dev/null || true
    wait "$WATCHDOG_PID" 2>/dev/null || true

    if [ -f "$TIMEOUT_FLAG" ]; then
        TIMED_OUT=1
        EXIT_CODE=$EXIT_TIMEOUT
    fi

    rm -f "$TIMEOUT_FLAG" "$DONE_FLAG" 2>/dev/null || true
}

run_directly() {
    "$SHELL_BIN" "$CMD_FILE" < "$STDIN_SOURCE" > "$OUT_FILE" 2>&1
    EXIT_CODE=$?
}

run_with_timeout_binary() {
    "$TIMEOUT_BIN" -s TERM -k 5 "$TIMEOUT_SECONDS" "$SHELL_BIN" "$CMD_FILE" \
        < "$STDIN_SOURCE" > "$OUT_FILE" 2>&1
    EXIT_CODE=$?

    if [ "$EXIT_CODE" -eq 124 ] || [ "$EXIT_CODE" -eq 137 ]; then
        TIMED_OUT=1
        EXIT_CODE=$EXIT_TIMEOUT
    fi
}

truncate_output() {
    OUTPUT_BYTES=$(file_size "$OUT_FILE")

    if ! is_digits "$OUTPUT_BYTES"; then
        OUTPUT_BYTES=0
        return 0
    fi

    _size=$OUTPUT_BYTES

    if [ "$_size" -le "$OUTPUT_LIMIT" ]; then
        return 0
    fi

    _half=$(( OUTPUT_LIMIT / 2 ))
    _keep="$RUN_DIR/$SEQUENCE.trim"

    {
        head -c "$_half" "$OUT_FILE" 2>/dev/null || true
        printf '\n\n[zcd] output truncated: %s bytes captured, %s bytes kept\n\n' "$_size" "$OUTPUT_LIMIT"
        tail -c "$_half" "$OUT_FILE" 2>/dev/null || true
    } > "$_keep" 2>/dev/null || true

    if [ -f "$_keep" ]; then
        mv "$_keep" "$OUT_FILE" 2>/dev/null || rm -f "$_keep" 2>/dev/null || true
        TRUNCATED=1
    fi
}

write_metadata() {
    _state_temp="$STATE_DIR/.$JOB_ID.json.tmp"

    {
        printf '{\n'
        printf '  "job_id": "%s",\n' "$JOB_ID"
        printf '  "last_sequence": "%s",\n' "$SEQUENCE"
        printf '  "last_started_at": %s,\n' "$STARTED_AT"
        printf '  "last_finished_at": %s,\n' "$FINISHED_AT"
        printf '  "last_duration_ms": %s,\n' "$DURATION_MS"
        printf '  "last_exit_code": %s,\n' "$EXIT_CODE"
        printf '  "last_timed_out": %s,\n' "$TIMED_OUT"
        printf '  "last_skipped": %s,\n' "$SKIPPED"
        printf '  "consecutive_failures": %s\n' "$CONSECUTIVE_FAILURES"
        printf '}\n'
    } > "$_state_temp" 2>/dev/null || return 0

    mv "$_state_temp" "$STATE_DIR/$JOB_ID.json" 2>/dev/null || rm -f "$_state_temp" 2>/dev/null || true

    _meta="$RUN_DIR/$SEQUENCE.json"
    _temp="$RUN_DIR/.$SEQUENCE.json.tmp"

    {
        printf '{\n'
        printf '  "sequence": "%s",\n' "$SEQUENCE"
        printf '  "started_at": %s,\n' "$STARTED_AT"
        printf '  "finished_at": %s,\n' "$FINISHED_AT"
        printf '  "duration_ms": %s,\n' "$DURATION_MS"
        printf '  "exit_code": %s,\n' "$EXIT_CODE"
        printf '  "timed_out": %s,\n' "$TIMED_OUT"
        printf '  "skipped": %s,\n' "$SKIPPED"
        printf '  "truncated": %s,\n' "$TRUNCATED"
        printf '  "stale_lock_broken": %s,\n' "$STALE_LOCK_BROKEN"
        printf '  "orphans_possible": %s,\n' "$ORPHANS_POSSIBLE"
        printf '  "output_bytes": %s,\n' "$OUTPUT_BYTES"
        printf '  "lock_style": "%s",\n' "$LOCK_STYLE"
        printf '  "runner_version": "%s"\n' "$ZCD_RUNNER_VERSION"
        printf '}\n'
    } > "$_temp" 2>/dev/null || return 0

    mv "$_temp" "$_meta" 2>/dev/null || rm -f "$_temp" 2>/dev/null || true
}

previous_failure_count() {
    _state="$STATE_DIR/$JOB_ID.json"

    if [ ! -f "$_state" ]; then
        printf '0'
        return 0
    fi

    _count=$(sed -n 's/.*"consecutive_failures"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$_state" 2>/dev/null | tail -n 1)

    if is_digits "$_count"; then
        printf '%s' "$_count"
    else
        printf '0'
    fi
}

list_run_metadata() {
    for _candidate in "$RUN_DIR"/*.json; do
        [ -f "$_candidate" ] || continue

        _name=${_candidate##*/}

        case "$_name" in
            [0-9]*-[0-9]*.json) printf '%s\n' "$_name" ;;
        esac
    done
}

prune_history() {
    [ "$RETAIN_RUNS" -gt 0 ] || return 0

    _metas=$(list_run_metadata | sort)
    _total=$(printf '%s\n' "$_metas" | grep -c .) || _total=0

    [ "$_total" -gt "$RETAIN_RUNS" ] || return 0

    _excess=$(( _total - RETAIN_RUNS ))

    printf '%s\n' "$_metas" | head -n "$_excess" | while IFS= read -r _meta; do
        [ -n "$_meta" ] || continue
        _base=${_meta%.json}
        rm -f "$RUN_DIR/$_base.json" "$RUN_DIR/$_base.out" 2>/dev/null || true
    done
}

emit_report() {
    [ "$EMIT_MODE" != "never" ] || return 0

    if [ "$EMIT_MODE" = "on-failure" ] && [ "$EXIT_CODE" -eq 0 ]; then
        return 0
    fi

    if [ "$TIMED_OUT" = "1" ]; then
        printf 'zcd: job %s timed out after %ss\n' "$JOB_NAME" "$TIMEOUT_SECONDS"
    else
        printf 'zcd: job %s exited %s after %sms\n' "$JOB_NAME" "$EXIT_CODE" "$DURATION_MS"
    fi

    if [ -s "$OUT_FILE" ]; then
        printf '\n'
        cat "$OUT_FILE" 2>/dev/null || true
    fi
}

report_capabilities() {
    printf 'runner_version=%s\n' "$ZCD_RUNNER_VERSION"
    printf 'base=%s\n' "$BASE_DIR"
    printf 'uid=%s\n' "$CURRENT_UID"
    printf 'flock=%s\n' "${FLOCK_BIN:-none}"
    printf 'timeout=%s\n' "${TIMEOUT_BIN:-none}"
    printf 'setsid=%s\n' "${SETSID_BIN:-none}"
    printf 'timeout_is_reliable=%s\n' "$TIMEOUT_IS_RELIABLE"

    printf 'shell=%s\n' "$SHELL_BIN"
}

SCRIPT_PATH=$0

case "$SCRIPT_PATH" in
    /*) ;;
    *) SCRIPT_PATH="$(pwd)/$SCRIPT_PATH" ;;
esac

BIN_DIR=$(dirname "$SCRIPT_PATH")
BASE_DIR=$(dirname "$BIN_DIR")

CURRENT_UID=$(id -u)

FLOCK_BIN=$(find_binary flock) || FLOCK_BIN=""
TIMEOUT_BIN=$(find_binary timeout) || TIMEOUT_BIN=""
SETSID_BIN=$(find_binary setsid) || SETSID_BIN=""

if [ -n "${ZCD_DISABLE_FLOCK:-}" ]; then
    FLOCK_BIN=""
fi

if [ -n "${ZCD_DISABLE_TIMEOUT:-}" ]; then
    TIMEOUT_BIN=""
fi

if [ -n "${ZCD_DISABLE_SETSID:-}" ]; then
    SETSID_BIN=""
fi

if [ -n "$TIMEOUT_BIN" ] || [ -n "$SETSID_BIN" ]; then
    TIMEOUT_IS_RELIABLE=1
else
    TIMEOUT_IS_RELIABLE=0
fi


SHELL_BIN=${SHELL:-/bin/sh}

if [ ! -x "$SHELL_BIN" ]; then
    SHELL_BIN=/bin/sh
fi

JOB_ID=""
LOCK_STYLE="none"
LOCK_HELD=0
STALE_LOCK_BROKEN=0
TIMED_OUT=0
SKIPPED=0
GROUP_KILL=0
ORPHANS_POSSIBLE=0
CHILD_PID=0
WATCHDOG_PID=0
TIMEOUT_FLAG=""
DONE_FLAG=""
TRUNCATED=0
EXIT_CODE=0
OUTPUT_BYTES=0

if [ "${1:-}" = "--detach" ]; then
    shift

    if [ -z "${1:-}" ]; then
        fail_refused "no job was given to run"
    fi

    "$SCRIPT_PATH" "$1" > /dev/null 2>&1 &

    exit 0
fi

if [ "${1:-}" = "--version" ]; then
    printf '%s\n' "$ZCD_RUNNER_VERSION"
    exit 0
fi

if [ "${1:-}" = "--check" ]; then
    report_capabilities
    exit 0
fi

JOB_ID=${1:-}

case "$JOB_ID" in
    [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
    *) fail_refused "the job identifier is not valid" ;;
esac

require_private_directory "$BASE_DIR" "the Cron Doctor directory"

JOBS_DIR="$BASE_DIR/jobs"
RUNS_DIR="$BASE_DIR/runs"
STATE_DIR="$BASE_DIR/state"
LOCKS_DIR="$BASE_DIR/locks"

CMD_FILE="$JOBS_DIR/$JOB_ID.cmd"
CONF_FILE="$JOBS_DIR/$JOB_ID.conf"
INPUT_FILE="$JOBS_DIR/$JOB_ID.in"

require_private_directory "$JOBS_DIR" "the job directory"
require_private_file "$CMD_FILE" "the job command file"

JOB_NAME=$(setting name "$JOB_ID")
TIMEOUT_SECONDS=$(numeric_setting timeout_seconds 0)
RETAIN_RUNS=$(numeric_setting retain_runs 20)
OUTPUT_LIMIT=$(numeric_setting output_limit_bytes 262144)
ON_OVERLAP=$(setting on_overlap skip)
EMIT_MODE=$(setting emit on-failure)

case "$EMIT_MODE" in
    on-failure | always | never) ;;
    *) EMIT_MODE="on-failure" ;;
esac

case "$ON_OVERLAP" in
    skip | allow) ;;
    *) ON_OVERLAP="skip" ;;
esac

RUN_DIR="$RUNS_DIR/$JOB_ID"
LOCK_FILE="$LOCKS_DIR/$JOB_ID.lock"
LOCK_DIR="$LOCKS_DIR/$JOB_ID.lockdir"

mkdir -p "$RUN_DIR" "$STATE_DIR" "$LOCKS_DIR" 2>/dev/null || warn "run history is not writable"
chmod 700 "$RUNS_DIR" "$RUN_DIR" "$STATE_DIR" "$LOCKS_DIR" 2>/dev/null || true

trap 'release_lock' EXIT
trap 'release_lock; exit 143' TERM
trap 'release_lock; exit 130' INT
trap 'release_lock; exit 129' HUP

if [ "$ON_OVERLAP" = "skip" ]; then
    if ! acquire_lock; then
        SKIPPED=1
        STARTED_AT=$(now_seconds)
        FINISHED_AT=$STARTED_AT
        DURATION_MS=0
        SEQUENCE="$STARTED_AT-$$"
        CONSECUTIVE_FAILURES=$(previous_failure_count)
        OUT_FILE="$RUN_DIR/$SEQUENCE.out"
        : > "$OUT_FILE" 2>/dev/null || true
        write_metadata
        prune_history
        exit 0
    fi
fi

STARTED_AT=$(now_seconds)
STARTED_MS=$(now_millis)
SEQUENCE="$STARTED_AT-$$"
OUT_FILE="$RUN_DIR/$SEQUENCE.out"

if [ -f "$INPUT_FILE" ]; then
    STDIN_SOURCE="$INPUT_FILE"
else
    STDIN_SOURCE="/dev/null"
fi

umask 077

if ! : > "$OUT_FILE" 2>/dev/null; then
    warn "output capture is not writable, running without a record"
    OUT_FILE="/dev/null"
fi

if [ "$TIMEOUT_SECONDS" -gt 0 ]; then
    if [ -n "$TIMEOUT_BIN" ]; then
        run_with_timeout_binary
    else
        run_with_watchdog
    fi
else
    run_directly
fi

FINISHED_AT=$(now_seconds)
FINISHED_MS=$(now_millis)
DURATION_MS=$(( FINISHED_MS - STARTED_MS ))

if [ "$DURATION_MS" -lt 0 ]; then
    DURATION_MS=0
fi

if [ "$OUT_FILE" != "/dev/null" ]; then
    truncate_output
fi

if [ "$EXIT_CODE" -eq 0 ]; then
    CONSECUTIVE_FAILURES=0
else
    CONSECUTIVE_FAILURES=$(( $(previous_failure_count) + 1 ))
fi

write_metadata
prune_history
release_lock
emit_report

exit "$EXIT_CODE"
